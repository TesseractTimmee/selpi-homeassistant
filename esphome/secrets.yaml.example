# keys used (HA's /config/esphome/secrets.yaml already has all but sppro_password)
wifi_ssid: "..."
wifi_password: "..."
ap_password: "..."
api_password: "..."       # API encryption key shared by the devices
sppro_password: "..."     # SP PRO login password
sppro_proxy_read_ip: "192.168.1.10/32"    # Home Assistant (selpi app): read-only proxy client
sppro_proxy_write_ip: "192.168.1.20/32"   # computer running SP LINK: may write through the proxy
